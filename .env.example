# Slack (https://api.slack.com/apps > 생성한 앱)
SLACK_BOT_TOKEN=xoxb-...        # OAuth & Permissions > Bot User OAuth Token
SLACK_APP_TOKEN=xapp-...        # Basic Information > App-Level Tokens (connections:write 스코프)

# Notion (https://www.notion.so/my-integrations)
NOTION_API_KEY=ntn_...

# (선택) 검색 대상의 루트 페이지 ID. 이 페이지와 모든 하위 페이지만 읽습니다.
# 비워두면 기본값(세렝게티 생활 가이드) 사용
NOTION_ROOT_PAGE_ID=

# (선택) 검색에서 뺄 페이지 ID들 (쉼표 구분)
NOTION_EXCLUDED_PAGE_IDS=

# (선택) 특정 주제를 지정 문서에서만 답하도록 고정 (형식: "주제:페이지ID", 쉼표 구분)
# 기본값은 src/pinned.js에 있음 (경조사 → 경조사 지원 제도)
PINNED_TOPICS=

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini        # 비용 절감용 기본값. 필요시 상위 모델로 변경
OPENAI_EMBEDDING_MODEL=text-embedding-3-small  # 검색 인덱스용 임베딩 모델

# (선택) 검색 인덱스 자동 갱신 주기 (시간 단위, 기본 24, 0이면 끔)
INDEX_REFRESH_HOURS=24

# (선택) 문서 오류 신고를 받을 슬랙 채널 ID (예: C0123ABCDE)
# 비워두면 신고는 로컬 로그(data/logs.jsonl)에만 기록됨
ERROR_REPORT_CHANNEL=
