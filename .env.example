# Slack (https://api.slack.com/apps > 생성한 앱)
SLACK_BOT_TOKEN=xoxb-...        # OAuth & Permissions > Bot User OAuth Token
SLACK_APP_TOKEN=xapp-...        # Basic Information > App-Level Tokens (connections:write 스코프)

# Notion (https://www.notion.so/my-integrations)
NOTION_API_KEY=ntn_...

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini        # 비용 절감용 기본값. 필요시 상위 모델로 변경
